# Copy to .env for local development (`docker compose up -d` starts the database).
DATABASE_URL=postgres://mahjong:mahjong@localhost:5432/mahjong

# Session signing secret, at least 32 random characters. Required in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-0000

# Public URL of the site. Leave unset in development (derived per request, so LAN access works).
# In production this falls back to ORIGIN.
# BETTER_AUTH_URL=https://example.com
