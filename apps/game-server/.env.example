# Copy to .env for local development. The root `npm run dev` starts this server next to the web app.
DATABASE_URL=postgres://mahjong:mahjong@localhost:5432/mahjong

# Where the session cookie is verified (the web app's /api/auth/get-session). In production: http://web:3000.
WEB_INTERNAL_URL=http://localhost:5173

# Public origin of the site. Leave unset in development (localhost and private LAN origins are accepted).
# ORIGIN=https://example.com

# PORT=3001
# Timers (ms), see src/config.ts for defaults:
# TURN_MS=5000 CALL_MS=5000 OPENING_TURN_MS=10000 BANK_MS=20000 READY_MS=12000 GRACE_MS=10000 ABANDON_MS=300000
# START_COUNTDOWN_MS=5000 HAND_COUNTDOWN_MS=3000 JOIN_MAX_MS=10000

# Bot players: the pool size and pacing are runtime settings (admin page, src/settings.ts). BOTS=off stops background
# games among bots (summoning bots for waiting players always runs).
# BOTS=off

# Shared with the web app: bearer token for the /internal admin API (at least 32 characters). Unset = API disabled.
# INTERNAL_TOKEN=
