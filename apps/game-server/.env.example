# Copy to .env for local development. The root `npm run dev` starts this server next to the web app.
DATABASE_URL=postgres://mahjong:mahjong@localhost:5432/mahjong

# Where the session cookie is verified (the web app's /api/auth/get-session). In production: http://web:3000.
WEB_INTERNAL_URL=http://localhost:5173

# Public origin of the site. Leave unset in development (localhost and private LAN origins are accepted).
# ORIGIN=https://example.com

# PORT=3001
# Timers (ms) and matchmaking, see src/config.ts for defaults:
# TURN_MS=8000 CALL_MS=5000 BANK_MS=15000 READY_MS=12000 GRACE_MS=10000 ABANDON_MS=300000 FILL_DELAY_MS=15000
